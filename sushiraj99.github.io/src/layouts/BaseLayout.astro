---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sushant Raj',
  description = 'Software engineer, cook, and gardener.',
} = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? pathname === '/' : pathname.startsWith(path);

const pageTitle = title === 'Sushant Raj' ? title : `${title} — Sushant Raj`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=DM+Mono:ital,wght@0,300..500;1,300..500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class:list={['site-title', { active: isActive('/') }]}>
          Sushant Raj
        </a>
        <ul>
          <li><a href="/projects" class:list={[{ active: isActive('/projects') }]}>projects</a></li>
          <li><a href="/work-experience" class:list={[{ active: isActive('/work-experience') }]}>work experience</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Sushant Raj</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:         #fafaf8;
    --fg:         #1c1c1a;
    --accent:     #2a5c45;
    --accent-hover: #224d38;
    --muted:      #6b6b62;
    --border:     #e5e3dc;
    --card-bg:    #f3f1eb;

    --font-serif: 'DM Serif Display', Georgia, serif;
    --font-sans:  'DM Sans', system-ui, sans-serif;
    --font-mono:  'DM Mono', 'Courier New', monospace;

    --max-w: 720px;
    --nav-h: 56px;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* ── Nav ── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: var(--max-w);
    margin: 0 auto;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    gap: 2rem;
  }

  .site-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .site-title:hover {
    color: var(--accent);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  nav ul a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  nav ul a:hover,
  nav ul a.active {
    color: var(--accent);
  }

  /* ── Main ── */
  main {
    flex: 1;
    width: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 3.5rem 1.5rem 4rem;
  }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
    text-align: center;
  }

  footer p {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ── Typography ── */
  h1, h2, h3, h4 {
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  h1 { font-size: clamp(2rem, 5vw, 2.75rem); }
  h2 { font-size: clamp(1.35rem, 3vw, 1.65rem); }
  h3 { font-size: 1.2rem; }

  p { line-height: 1.7; }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s;
  }

  a:hover { text-decoration-color: currentColor; }

  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--card-bg);
    padding: 0.15em 0.35em;
    border-radius: 3px;
  }

  pre {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem;
    overflow-x: auto;
    line-height: 1.6;
  }

  pre code { background: none; padding: 0; }

  /* ── Prose (markdown pages) ── */
  .prose > * + * { margin-top: 1.25em; }
  .prose h2 { margin-top: 2.5em; }
  .prose h3 { margin-top: 2em; }
  .prose ul, .prose ol { padding-left: 1.5em; }
  .prose li + li { margin-top: 0.4em; }
  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1.25em;
    color: var(--muted);
    font-style: italic;
  }
  .prose img { max-width: 100%; border-radius: 6px; }
  .prose hr { border: none; border-top: 1px solid var(--border); margin: 2em 0; }

  /* ── Post cards (shared across indexes) ── */
  .posts-grid {
    display: grid;
    gap: 0.75rem;
  }

  .post-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    transition: border-color 0.15s;
  }

  .post-card:hover { border-color: var(--accent); }

  .post-card-link {
    display: block;
    padding: 1.125rem 1.375rem;
    text-decoration: none;
    color: inherit;
  }

  .post-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-card-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--fg);
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .post-card:hover .post-card-title { color: var(--accent); }

  .post-card-date {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-card-desc {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
    margin-top: 0.375rem;
  }

  .post-card-meta {
    font-size: 0.8125rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: 0.5rem;
  }
</style>
