---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hey, I'm Sushant!"
  description="Robotics Engineer, Random Project Enthusiast, Semi-Decent Cook/Gardener"
>
  <section class="hero">
    <div class="hero-text">
      <h1>Hey, I'm Sushant!</h1>
      <p class="tagline">
        Robotics Engineer, Random Project Enthusiast, Semi-Decent Cook/Gardener
      </p>
    </div>
    <img
      src="/profile_pic.png"
      alt="Sushant Raj"
      class="hero-photo"
    />
  </section>

  <section class="sections">
    <a href="/projects" class="section-card">
      <span class="section-card__label">Projects</span>
      <span class="section-card__desc">Laser Cutter, CNC Mill, 3D Printers, etc</span>
      <span class="section-card__arrow">→</span>
    </a>
<a href="/work-experience" class="section-card">
      <span class="section-card__label">Work Experience</span>
      <span class="section-card__desc">My background in robotics and software.</span>
      <span class="section-card__arrow">→</span>
    </a>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    letter-spacing: -0.03em;
  }

  .tagline {
    margin-top: 1rem;
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 46ch;
    line-height: 1.65;
  }

  .hero-photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 2px solid var(--border);
    background: #d6e8f5;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .hero-photo {
      width: 100px;
      height: 100px;
    }
  }

  /* ── Sections grid ── */
  .sections {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (max-width: 560px) {
    .sections {
      grid-template-columns: 1fr;
    }
  }

  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.375rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, background 0.15s;
  }

  .section-card:hover {
    border-color: var(--accent);
    background: #eeecea;
  }

  .section-card__label {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--fg);
    letter-spacing: -0.02em;
    transition: color 0.15s;
  }

  .section-card:hover .section-card__label {
    color: var(--accent);
  }

  .section-card__desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.45;
    flex: 1;
  }

  .section-card__arrow {
    font-size: 1rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s, transform 0.15s;
    align-self: flex-end;
  }

  .section-card:hover .section-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

</style>
