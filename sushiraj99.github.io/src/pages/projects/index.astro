---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectImageSlider from '../../components/ProjectImageSlider.jsx';

const projects = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
    .map(async project => ({ ...project, rendered: await render(project) }))
);
---

<BaseLayout
  title="Projects"
  description="DIY projects, builds, and making things."
>
  <div class="page-header">
    <h1>Projects</h1>
  </div>

  <p class="intro">
    I was lucky enough to have access to a pretty great makerspace at UConn,
    which kicked off my whole DIY obsession. I've built up a fun little space
    where I can work on projects. I do have an
    <a href="https://www.etsy.com/shop/madewithanbu" target="_blank" rel="noopener">Etsy</a> and a
    <a href="https://www.instagram.com/stuffbysushi/" target="_blank" rel="noopener">project Instagram</a>,
    but most of the things I make are usually gifts or just for fun.
  </p>

  <div class="projects-grid">
    {projects.map(project => (
      <article class="project-card">
        {project.data.images && project.data.images.length > 0 && (
          <ProjectImageSlider
            images={project.data.images}
            title={project.data.title}
            client:load
          />
        )}
        <div class="project-card__body">
          <h3>{project.data.title}</h3>
          <p class="project-card__desc">{project.data.description}</p>
          <div class="project-card__body-text prose">
            <project.rendered.Content />
          </div>
          {project.data.tools && project.data.tools.length > 0 && (
            <div class="project-card__tools">
              {project.data.tools.map(t => <span>{t}</span>)}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="subpages">
    <a href="/projects/gifts" class="subpage-link">Favorite Gifts →</a>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .intro {
    font-size: 1.0625rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 58ch;
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 520px) {
    .projects-grid { grid-template-columns: 1fr; }
  }

  .project-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
    transition: border-color 0.15s;
  }

  .project-card:hover { border-color: var(--accent); }

  /* slider styles are global so React component can use them */


  .project-card__body {
    padding: 1.125rem 1.25rem;
  }

  .project-card__body h3 {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
    transition: color 0.15s;
  }

  .project-card:hover .project-card__body h3 { color: var(--accent); }

  .project-card__desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .project-card__body-text {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    margin-top: 0.75rem;
    max-height: 160px;
    overflow-y: auto;
  }

  .project-card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .project-card__tools span {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15em 0.5em;
  }

  .subpages {
    display: flex;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .subpage-link {
    font-size: 0.9375rem;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.4em 0.9em;
    transition: border-color 0.15s, background 0.15s;
  }

  .subpage-link:hover {
    border-color: var(--accent);
    background: var(--card-bg);
  }
</style>
